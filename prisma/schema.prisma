generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients      Client[]      @relation("ClientOwner")
  projects     Project[]     @relation("ProjectOwner")
  tasks        Task[]        @relation("TaskAssignee")
  notes        Note[]
  timeEntries  TimeEntry[]
  activities   Activity[]
}

model Client {
  id           String       @id @default(uuid())
  name         String
  company      String?
  email        String?
  phone        String?
  website      String?
  address      String?
  city         String?
  zip          String?
  country      String?
  vatId        String?
  status       String       @default("LEAD")
  source       String?
  tags         String? // comma separated tags
  notesText    String?
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownerId      String?
  owner        User?        @relation("ClientOwner", fields: [ownerId], references: [id])

  projects     Project[]
  invoices     Invoice[]
  contracts    Contract[]
  notes        Note[]
  documents    Document[]
  contacts     Contact[]
  activities   Activity[]

  @@index([status])
  @@index([ownerId])
}

model Contact {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Project {
  id          String        @id @default(uuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String        @default("PLANNED")
  budget      Float?
  hourlyRate  Float?
  startDate   DateTime?
  dueDate     DateTime?
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id])

  tasks       Task[]
  invoices    Invoice[]
  timeEntries TimeEntry[]
  documents   Document[]
  notes       Note[]
  activities  Activity[]

  @@index([status])
  @@index([clientId])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String       @default("OPEN")
  priority    String       @default("MEDIUM")
  dueDate     DateTime?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([status])
}

model TimeEntry {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  description String?
  minutes     Int
  billable    Boolean   @default(true)
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

model Invoice {
  id            String        @id @default(uuid())
  number        String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  status        String        @default("DRAFT")
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  taxRate       Float         @default(19)
  discount      Float         @default(0)
  notes         String?
  currency      String        @default("EUR")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  payments      Payment[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  position    Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String?
  paidAt    DateTime @default(now())
  note      String?

  @@index([invoiceId])
}

model Contract {
  id         String         @id @default(uuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  status     String         @default("DRAFT")
  value      Float?
  startDate  DateTime?
  endDate    DateTime?
  signedAt   DateTime?
  fileUrl    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([clientId])
}

model Document {
  id         String   @id @default(uuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  url        String
  mimeType   String?
  size       Int?
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
}

model Note {
  id         String   @id @default(uuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
}

model Activity {
  id        String   @id @default(uuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
}
