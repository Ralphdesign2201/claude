# Pfad zur SQLite-Datei (relativ zum Projektordner oder absolut)
DATABASE_PATH="database/app.db"

# Pflicht: langer, zufälliger Wert (mind. 16 Zeichen), z. B.  php -r 'echo bin2hex(random_bytes(32));'
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Erlaubte Origins für CORS, kommagetrennt ("*" = alle)
CORS_ORIGIN="http://localhost:5173"

# Nach dem ersten Benutzer (wird Admin) ist die Selbstregistrierung standardmäßig gesperrt
ALLOW_REGISTRATION=false

# Rate-Limits pro IP und 15 Minuten
RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=10

# Absenderdaten für die Rechnungs-PDFs (Zeilen der Adresse mit | trennen)
COMPANY_NAME="Ihr Studio"
COMPANY_ADDRESS="Musterstraße 1|12345 Musterstadt"
COMPANY_EMAIL=""
COMPANY_PHONE=""
COMPANY_WEBSITE=""
COMPANY_VAT_ID=""
COMPANY_TAX_NUMBER=""
COMPANY_BANK=""
COMPANY_IBAN=""
COMPANY_BIC=""
# Hinweis bei 0 % Umsatzsteuer (z. B. Kleinunternehmer) – bitte mit dem Steuerberater abstimmen
INVOICE_ZERO_TAX_NOTE="Gemäß § 19 UStG wird keine Umsatzsteuer berechnet."
INVOICE_CLOSING="Vielen Dank für Ihren Auftrag und das entgegengebrachte Vertrauen."
# Zeitzone für Datumsangaben im PDF
APP_TIMEZONE="Europe/Berlin"

# ---- E-Mail-Versand (Rechnungen, Angebote, Mahnungen) ----
# Zugangsdaten bekommst du von deinem Mail-Anbieter (z. B. All-Inkl, IONOS, Strato, Google Workspace, Mailbox.org)
SMTP_HOST=""
SMTP_PORT=587
# tls = STARTTLS (Port 587), ssl = von Anfang an verschlüsselt (Port 465), none = unverschlüsselt (nur lokal)
SMTP_ENCRYPTION="tls"
SMTP_USER=""
SMTP_PASSWORD=""
# Absenderadresse (muss zum Mail-Konto passen); Standard: COMPANY_EMAIL
MAIL_FROM=""
MAIL_FROM_NAME=""
# Optional: Kopie jeder versendeten Mail an diese Adresse
MAIL_BCC=""
# Zum lokalen Ausprobieren ohne Mailserver: MAIL_DRIVER=file legt .eml-Dateien in database/outbox/ ab
MAIL_DRIVER=""

# ---- Angebote, Mahnwesen, Abos ----
QUOTE_VALID_DAYS=30
PAYMENT_DAYS=14
QUOTE_CLOSING="Wir freuen uns auf Ihre Beauftragung."
# Frist (Tage) und Gebühren (€) der Mahnstufen: 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = letzte Mahnung
REMINDER_DAYS=7
REMINDER_FEE_1=0
REMINDER_FEE_2=0
REMINDER_FEE_3=0
# Token (mind. 16 Zeichen) für den Cron-Aufruf per URL: POST /api/cron/run mit Header X-Cron-Token
CRON_TOKEN=""

# ---- Kundenportal ----
# Öffentliche Adresse der Anwendung (für Portal-Links in E-Mails), ohne Schrägstrich am Ende
APP_URL="https://crm.example.com"
# Wie lange ein Portal-Link gültig ist (Tage); 0 = unbegrenzt
PORTAL_TOKEN_DAYS=365

# Kundenkonten: Selbstregistrierung im Portal (off = abschalten), AGB-/Datenschutz-Links (Zustimmung bei der Registrierung)
PORTAL_REGISTRATION=open
TERMS_URL=""
PRIVACY_URL=""
PORTAL_SESSION_DAYS=14
REGISTER_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=10

# ---- Domain-Lizenzen ----
# Signaturschlüssel: wird beim ersten Gebrauch erzeugt und hier abgelegt (Standard database/license.key). WICHTIG: sichern, nie ins Git!
LICENSE_KEY_FILE=""
# Alternativ der Schlüssel direkt (Base64); hat Vorrang vor der Datei
LICENSE_SECRET_KEY=""
# Kulanzfrist (Tage) nach Ablauf des bezahlten Zeitraums bei Mietlizenzen
LICENSE_GRACE_DAYS=14
# Wie lange die Software eine gültige Antwort zwischenspeichert (Stunden) und wie lange sie bei nicht erreichbarem Server weiterläuft (Tage)
LICENSE_CACHE_HOURS=24
LICENSE_OFFLINE_DAYS=7
# Wie oft ein Kunde die Domain selbst ändern darf
LICENSE_DOMAIN_CHANGES=2
# localhost, *.test, *.local und 127.x ohne Lizenz-Domain erlauben
LICENSE_ALLOW_DEV=true

# ---- Datensicherung ----
# Ordner für Backups (am besten außerhalb des Web-Verzeichnisses); Standard: backups/ im Projektordner
BACKUP_DIR=""
# Passwort für die AES-256-Verschlüsselung der Backups (dringend empfohlen: Backups enthalten alle Kundendaten)
BACKUP_PASSPHRASE=""
# Zusätzliche Kopie jedes Backups, z. B. in einen Cloud-/Netzwerk-Ordner oder auf eine externe Platte
BACKUP_COPY_DIR=""
# Automatische Sicherung beim Cron-Lauf, wenn das letzte Backup älter ist als ... Stunden
BACKUP_AUTO=true
BACKUP_INTERVAL_HOURS=24
# Aufbewahrung: die neuesten N Backups + je Monat das neueste der letzten M Monate
BACKUP_KEEP=14
BACKUP_KEEP_MONTHS=12
# Ordner für hochgeladene Dokumente (Standard: uploads/ im Projektordner)
UPLOAD_DIR=""
