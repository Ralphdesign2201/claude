{
  "name": "ralphdesign/webdesigner-crm",
  "description": "Kundenverwaltung für Webdesigner (PHP + SQLite)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-mbstring": "*"
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "seed": "php bin/seed.php",
    "serve": "php -d upload_max_filesize=25M -d post_max_size=26M -S localhost:4000 -t public public/index.php",
    "test": "php tests/run.php"
  },
  "config": {
    "process-timeout": 0
  }
}
