# Liegt das Projekt direkt im Web-Verzeichnis (z. B. public_html), leitet diese Datei alles an den Ordner public/ um.
# Dadurch sind database/, src/, .env, Backups usw. von außen nie erreichbar. Zeigt die Domain bereits auf public/, wird diese Datei nicht gebraucht.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
